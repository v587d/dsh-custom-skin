{
  "name": "dsh-custom-skin",
  "version": "0.3.0",
  "description": "DSH Web GUI plugin: custom UI/code fonts plus 24 color palettes, configured on the Plugins page and persisted to the profile.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "author": "Shawn",
  "homepage": "https://github.com/v587d/dsh-custom-skin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v587d/dsh-custom-skin.git"
  },
  "bugs": {
    "url": "https://github.com/v587d/dsh-custom-skin/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "font",
    "theme",
    "skin",
    "ui"
  ],
  "license": "MIT"
}
